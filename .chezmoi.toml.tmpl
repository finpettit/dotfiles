{{- $work := promptBoolOnce . "work" "Work machine" -}}
{{- $name := promptStringOnce . "name" "Git name on this machine" -}}
{{- $email := promptStringOnce . "email" "Git email on this machine" -}}
[data]
    work = {{ $work }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
[edit]
    command = "nvim"
