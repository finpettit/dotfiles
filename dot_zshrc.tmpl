typeset -U path
export PATH=$HOME/.local/bin:$HOME/bin:$HOME/.composer/vendor/bin:/usr/local/bin:$PATH
export ZSH="$HOME/.oh-my-zsh"
export LANG=en_GB.UTF-8
export XDG_CONFIG_HOME="$HOME/.config" # Lazygit config

ZSH_THEME=""
plugins=(
    brew
    git
    npm
    nvm
    alias-finder
    zsh-autosuggestions
    zsh-syntax-highlighting
    )
zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' autoload yes
zstyle ':omz:plugins:nvm' silent-autoload yes
zstyle ':omz:plugins:alias-finder' autoload yes

source $ZSH/oh-my-zsh.sh
source ~/.aliases
source <(fzf --zsh)

{{ if eq .chezmoi.os "darwin" -}}
# Add HERD PHP to CLI
export PATH="$HOME/Library/Application Support/Herd/bin":$PATH
export HERD_PHP_74_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/74/"
export HERD_PHP_80_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/80/"
export HERD_PHP_81_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/81/"
export HERD_PHP_82_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/82/"
export HERD_PHP_83_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/83/"
export HERD_PHP_84_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/84/"
export HERD_PHP_85_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/85/"
export HERD_PHP_86_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/86/"
{{- end }}

# Boot
eval "$(starship init zsh)"
eval "$(zoxide init zsh --cmd cd)"

# WezTerm shell integration
[[ -n "$WEZTERM_PANE" && -r ~/.local/share/wezterm/wezterm.sh ]] && source ~/.local/share/wezterm/wezterm.sh
